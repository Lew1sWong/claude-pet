{
  "name": "claude-pet-desktop",
  "productName": "Claude Pet",
  "version": "0.6.0",
  "description": "完全悬浮的 8-bit Claude 用量桌宠：透明、置顶、全屏游走（macOS / Windows）",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/fix-keyserver-perms.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "test": "node --test",
    "sync-web": "node scripts/sync-web.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.claudepet.desktop",
    "productName": "Claude Pet",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/node-global-key-listener/bin/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "lib/**/*",
      "assets/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Claude Pet"
    }
  },
  "dependencies": {
    "node-global-key-listener": "^0.3.0"
  }
}
